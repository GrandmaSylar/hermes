{
  "expo": {
    "name": "QSS Mobile Banking",
    "slug": "qss-mobile-banking",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.qss.mobilebanking",
      "supportsTablet": true
    },
    "android": {
      "package": "com.qss.mobilebanking",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow QSS Mobile Banking to take the member's photo, ID card and signature for KYC.",
          "photosPermission": "Allow QSS Mobile Banking to choose KYC pictures from your photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow QSS Mobile Banking to use Face ID to unlock the app."
        }
      ]
    ],
    "scheme": "qssmobilebanking",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c3ad47a-8479-45ad-88f2-2193b70679e2"
      }
    },
    "owner": "grandmaa"
  }
}
