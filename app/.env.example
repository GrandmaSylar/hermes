# Copy this file to `.env.local` in this folder (it is ignored by git), fill it in, then run `npm start`.
# Expo reads only this folder's env files, and only variables that start with EXPO_PUBLIC_.
# After changing a value, restart with `npm run start:clear`.

# The field server the app talks to. No path at the end: the app adds /v1 itself.
# Leave it out to run on built-in demo data (the sign-in screen then says "Demo mode").
# A release build must use https://.
EXPO_PUBLIC_API_URL=https://187-77-163-172.sslip.io

# Expo Go has no encrypted database (SQLCipher), so the app refuses to store member data there
# unless this is "true". Development only, and only with test data. It has no effect in a release.
EXPO_PUBLIC_ALLOW_UNENCRYPTED_DB=true
