# Copy to .env on the server. Never commit the real file.
PORT=3000
JWT_SECRET=                 # at least 32 random characters: openssl rand -base64 48
DB_SERVER=sqlserver         # the database container's name on the shared Docker network
DB_PORT=1433                # the port INSIDE the Docker network (not the published 1436)
DB_NAME=bankpro
DB_USER=hermes_field        # the limited login from deploy/create-db-login.sql, not sa
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
MAX_SINGLE_AMOUNT=5000.00
MAX_UNSYNCED_AMOUNT=50000.00
MAX_UNSYNCED_ITEMS=200
MAX_BACKDATE_DAYS=7
